# Practice Studio Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local or share real credentials.

# =============================================================================
# GROQ AI (Required for live AI evaluation & transcription)
# Get API key from: https://console.groq.com
# =============================================================================
GROQ_API_KEY=
# Chat model supporting JSON schema (e.g., llama-3.3-70b-versatile, mixtral-8x7b-32768)
OPENAI_CHAT_MODEL=
# Speech-to-text model (e.g., whisper-large-v3-turbo, whisper-large-v3)
OPENAI_STT_MODEL=
# Text-to-speech model (optional, for future TTS feature)
OPENAI_TTS_MODEL=

# =============================================================================
# FIREBASE ADMIN SDK (Server-only, required for production)
# Generate at: Firebase Console > Project Settings > Service Accounts
# =============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Private key must preserve newlines. In .env.local, use actual newlines:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----
# ...
# -----END PRIVATE KEY-----
# "
# In Vercel/Cloud env vars, use \n for newlines.
FIREBASE_PRIVATE_KEY=

# =============================================================================
# FIREBASE WEB CONFIG (Public, safe to expose in client bundle)
# Get at: Firebase Console > Project Settings > General > Your apps > Web app
# =============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# =============================================================================
# DEVELOPMENT SETTINGS (Never enable in production!)
# =============================================================================
# Enable demo mode: uses length-based simulated scoring (no AI calls)
DEMO_MODE=false
# Use Firebase emulators instead of live project
NEXT_PUBLIC_USE_EMULATORS=false
# Emulator hosts (uncomment when using emulators)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# =============================================================================
# QUICK REFERENCE: Required for Each Mode
# =============================================================================
# DEVELOPMENT (with emulators):
#   DEMO_MODE=true
#   NEXT_PUBLIC_USE_EMULATORS=true
#   FIREBASE_PROJECT_ID=demo-interview-test
#   FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
#   FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
#   (No Groq keys or real Firebase credentials needed)

# DEVELOPMENT (live services):
#   DEMO_MODE=false
#   NEXT_PUBLIC_USE_EMULATORS=false
#   All GROQ_* and FIREBASE_* variables required

# PRODUCTION (Vercel):
#   DEMO_MODE=false
#   NEXT_PUBLIC_USE_EMULATORS=false
#   All GROQ_* and FIREBASE_* variables required
#   Set in Vercel Dashboard > Settings > Environment Variables